{
  "_комментарий": [
    "КЛИЕНТСКИЙ роутинг для sing-box (Happ, sing-box, NekoBox).",
    "geositez-* — наши списки (политика), roscom-* — hydraponique/roscomvpn-* (инвентарь РФ/РБ).",
    "Правила проверяются сверху вниз. Порядок критичен в трёх местах:",
    "  1. connectivity первым — иначе captive.apple.com уедет в direct;",
    "  2. twitch-ads выше twitch — gql.twitch.tv это поддомен twitch.tv;",
    "  3. ads выше whitelist — mradx.net у них direct, у нас block."
  ],
  "route": {
    "rules": [
      { "rule_set": "geositez-connectivity", "outbound": "proxy" },
      { "rule_set": "geositez-ads", "outbound": "block" },

      { "rule_set": "geositez-twitch-ads", "outbound": "proxy" },
      { "rule_set": "roscom-twitch", "outbound": "direct" },

      { "rule_set": "geositez-system", "outbound": "direct" },

      { "rule_set": "roscom-geoblock", "outbound": "proxy" },
      { "rule_set": "geositez-ai", "outbound": "proxy" },

      { "rule_set": "geositez-ru", "outbound": "direct" },
      { "rule_set": "roscom-whitelist", "outbound": "direct" },
      { "rule_set": "roscom-direct-ip", "outbound": "direct" },

      { "domain_suffix": [".ru", ".su", ".xn--p1ai"], "outbound": "direct" },
      { "ip_is_private": true, "outbound": "direct" }
    ],
    "rule_set": [
      {
        "tag": "geositez-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Mrzalupa-lolz/geositez/releases/latest/download/site-ads.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Mrzalupa-lolz/geositez/releases/latest/download/site-ru.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-system",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Mrzalupa-lolz/geositez/releases/latest/download/site-system.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-connectivity",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Mrzalupa-lolz/geositez/releases/latest/download/site-connectivity.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-ai",
        "type": "remote",
        "format": "binary",
