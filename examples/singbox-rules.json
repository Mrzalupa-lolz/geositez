{
  "_комментарий": [
    "КЛИЕНТСКИЙ роутинг для sing-box (Happ, sing-box, NekoBox).",
    "Списки те же самые, но в бинарном формате .srs — их собирает workflow.",
    "Замени OWNER/geositez на свой репозиторий.",
    "Правила проверяются сверху вниз; CONNECTIVITY должен идти первым."
  ],
  "route": {
    "rules": [
      { "rule_set": "geositez-connectivity", "outbound": "proxy" },
      { "rule_set": "geositez-ads", "outbound": "block" },
      { "rule_set": "geositez-system", "outbound": "direct" },
      { "rule_set": "geositez-ru", "outbound": "direct" },
      { "rule_set": "geositez-ru-ip", "outbound": "direct" },
      { "domain_suffix": [".ru", ".su", ".xn--p1ai"], "outbound": "direct" },
      { "rule_set": "geositez-ai", "outbound": "proxy" },
      { "ip_is_private": true, "outbound": "direct" }
    ],
    "rule_set": [
      {
        "tag": "geositez-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/site-ads.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-ru",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/site-ru.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-ru-ip",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/ip-ru-ip.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-system",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/site-system.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-connectivity",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/site-connectivity.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-ai",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/OWNER/geositez/releases/latest/download/site-ai.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      }
    ]
  }
}
