        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "geositez-twitch-ads",
        "type": "remote",
        "format": "binary",
        "url": "https://github.com/Mrzalupa-lolz/geositez/releases/latest/download/site-twitch-ads.srs",
        "download_detour": "direct",
        "update_interval": "24h"
      },
      {
        "tag": "roscom-direct-ip",
        "type": "remote",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/hydraponique/roscomvpn-geoip/release/sing-box/direct.srs",
        "download_detour": "direct",
        "update_interval": "24h"
