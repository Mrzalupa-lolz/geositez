{
  "_комментарий": [
    "КЛИЕНТСКИЙ роутинг для sing-box (Happ, sing-box, NekoBox).",
    "",
    "geositez-* — наши списки (политика), rv-* — hydraponique/roscomvpn-*",
    "(инвентарь РФ/РБ). Полная раскладка «какой набор куда» — в README.",
    "",
    "geositez-ads уже содержит ADS-NETWORKS (подмешан через include: при",
    "сборке), отдельный набор для него не нужен.",
    "",
    "sing-box разрешает перечислять несколько наборов в одном правиле —",
    "правила сгруппированы по назначению, но ПОРЯДОК ГРУПП строгий:",
    "  1. connectivity выше rv-apple  — captive.apple.com лежит в их apple;",
    "  2. twitch-ads   выше rv-twitch — gql.twitch.tv поддомен twitch.tv;",
    "  3. system       выше rv-google-play — там mtalk.google.com, пуши FCM;",
    "  4. rv-geoblock  выше domain_suffix .ru — внутри habr.com и 4pda.ru;",
    "  5. ads          выше rv-whitelist — mradx.net у них direct, у нас block."
  ],
  "route": {
    "rules": [
      { "_": "1. проверка связи — в туннель, нода развернёт в direct",
        "rule_set": "geositez-connectivity", "outbound": "proxy" },

      { "_": "2. реклама, трекеры, телеметрия Windows",
        "rule_set": ["geositez-ads", "rv-win-spy"], "outbound": "block" },

      { "_": "3. Twitch: токен и манифест в туннель — качество Source",
        "rule_set": "geositez-twitch-ads", "outbound": "proxy" },

      { "_": "4. сам Twitch напрямую — с РФ-IP рекламу не подставляют",
        "rule_set": "rv-twitch", "outbound": "direct" },

      { "_": "5. пуши, обновления ОС, NTP, OCSP — строго мимо VPN",
        "rule_set": "geositez-system", "outbound": "direct" },

      { "_": "6. всё, что режет российские IP или недоступно из РФ",
        "rule_set": ["geositez-ai", "rv-geoblock", "rv-deepmind", "rv-youtube",
                     "rv-telegram", "rv-github", "rv-google-play", "rv-pinterest"],
        "outbound": "proxy" },

      { "_": "7. российское, игры и торренты — напрямую",
        "rule_set": ["geositez-ru", "rv-whitelist", "rv-category-ru", "rv-apple",
                     "rv-microsoft", "rv-steam", "rv-epicgames", "rv-riot",
                     "rv-origin", "rv-eft", "rv-faceit", "rv-torrent"],
        "outbound": "direct" },

      { "_": "8. зоны .ru / .su / .рф целиком",
        "domain_suffix": [".ru", ".su", ".xn--p1ai"], "outbound": "direct" },

      { "_": "9. сети РФ/РБ по IP — ловит приложения, ходящие на голый адрес",
        "rule_set": ["rv-ip-direct", "rv-ip-whitelist"], "outbound": "direct" },

      { "_": "10. локалка и служебные диапазоны",
        "rule_set": ["rv-private-domain", "rv-ip-private"], "outbound": "direct" },
      { "ip_is_private": true, "outbound": "direct" }
    ],
